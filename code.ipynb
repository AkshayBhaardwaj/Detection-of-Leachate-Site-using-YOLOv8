import os
import requests

# Define the URL of the online image
image_url = 'https://media.istockphoto.com/id/505239248/photo/humayun-tomb-new-delhi-india.jpg?s=2048x2048&w=is&k=20&c=zcpBsKWREyEgppKrHpR6KeVflgOfvEy-uk7_J-JBzAY='
# Define the local path to save the downloaded image
local_image_path = 'downloaded_image.jpg'

# Download the image from the URL
response = requests.get(image_url)
if response.status_code == 200:
    with open(local_image_path, 'wb') as f:
        f.write(response.content)
    print(f'Image successfully downloaded: {local_image_path}')
else:
    print(f'Failed to download image. Status code: {response.status_code}')

# Define the path to the YOLO model file
model_path = 'best.pt'

# Verify if the model file exists
if os.path.exists(model_path):
    print(f'Model file found: {model_path}')
    # Run YOLOv8 prediction on the downloaded image
    !yolo detect predict model={model_path} source={local_image_path}
else:
    print(f'Model file not found: {model_path}')






import os
import requests
import glob

# Define the path to the directory containing images
image_directory = 'test'

# Define the path to the YOLO model file
model_path = 'best.pt'

# Verify if the model file exists
if os.path.exists(model_path):
    print(f'Model file found: {model_path}')
    
    # Find all image files in the specified directory (supports .jpg, .jpeg, .png, .bmp)
    image_paths = glob.glob(os.path.join(image_directory, '*'))
    image_paths = [img for img in image_paths if img.lower().endswith(('.jpg', '.jpeg', '.png', '.bmp','.mp4'))]

    # Run YOLOv8 prediction on each image in the directory
    for image_path in image_paths:
        print(f'Running YOLOv8 prediction on {image_path}...')
        os.system(f'yolo detect predict model={model_path} source={image_path}')
else:
    print(f'Model file not found: {model_path}')





#video
import os
import requests
import glob

# Define the path to the YOLO model file
model_path = 'best.pt'

# Define the directory to save the results
results_directory = 'results'
os.makedirs(results_directory, exist_ok=True)

# Define the path to the video file or directory containing images
source_path = 'a.mp4'

# Verify if the model file exists
if os.path.exists(model_path):
    print(f'Model file found: {model_path}')
    
    # Check if the source is a file or directory
    if os.path.isfile(source_path):
        # Handle video or single image file
        print(f'Running YOLOv8 prediction on {source_path}...')
        os.system(f'yolo detect predict model={model_path} source={source_path} save=True')
        
        # Move the results to the specified results directory
        for file in glob.glob('runs/predict/*'):
            shutil.move(file, results_directory)
    elif os.path.isdir(source_path):
        # Find all image files in the specified directory (supports .jpg, .jpeg, .png, .bmp)
        image_paths = glob.glob(os.path.join(source_path, '*'))
        image_paths = [img for img in image_paths if img.lower().endswith(('.jpg', '.jpeg', '.png', '.bmp', '.mp4'))]

        # Run YOLOv8 prediction on each image or video in the directory
        for image_path in image_paths:
            print(f'Running YOLOv8 prediction on {image_path}...')
            os.system(f'yolo detect predict model={model_path} source={image_path} save=True')
            
            # Move the results to the specified results directory
            for file in glob.glob('runs/predict/*'):
                shutil.move(file, results_directory)
    else:
        print(f'Invalid source path: {source_path}')
else:
    print(f'Model file not found: {model_path}')






